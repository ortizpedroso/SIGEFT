# Produção — VPS Hostinger compartilhada com www.eventosbr.app.br
# Copie para .env.production (não commitar).
# A Métrica NÃO usa 80/443; o site existente continua dono dessas portas.

DB_USER=metrica
DB_PASSWORD=troque-esta-senha-do-postgres
DB_NAME=metrica
SECRET_KEY=gere-uma-chave-com-openssl-rand-hex-32
ADMIN_EMAIL=admin@tjrr.jus.br
ADMIN_PASSWORD=troque-esta-senha-do-admin
ENV=production

# Subdomínio no mesmo IP do eventosbr (crie o registro A no DNS).
CORS_ORIGINS=https://sigep.eventosbr.app.br
ALLOWED_HOSTS=sigep.eventosbr.app.br,api,localhost,127.0.0.1
COOKIE_SECURE=true
API_URL=http://api:8000

# NÃO use SITE_ADDRESS/Caddy nesta VPS (ocuparia 80/443 e derrubaria o eventosbr).
# Caddy só faz sentido numa VPS dedicada, sem outro site.
